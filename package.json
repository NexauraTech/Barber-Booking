{
  "name": "barber-booking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/migrate.ts --reset && tsx scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p app/customer/tsconfig.json",
    "dev": "tsx watch scripts/serve.ts",
    "serve": "tsx scripts/serve.ts",
    "app:dev": "vite --config app/customer/vite.config.ts",
    "app:build": "vite build --config app/customer/vite.config.ts",
    "app:preview": "vite preview --config app/customer/vite.config.ts",
    "app:smoke": "node scripts/smoke-app.mjs"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.1",
    "fastify": "^5.12.5",
    "luxon": "^3.5.0",
    "pg": "^8.13.1",
    "preact": "^10.29.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.7",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "playwright": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.2"
  }
}
